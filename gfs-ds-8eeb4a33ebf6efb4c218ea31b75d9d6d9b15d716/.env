# Docker Internal Mode Config
# Use this for running client INSIDE Docker container
# Commands:
#   cp .env.docker .env
#   docker compose up -d --build

GFS_MODE=docker
GFS_CHUNK1_HOST=chunk1
GFS_CHUNK2_HOST=chunk2
GFS_MASTER_HOST=master
GFS_MASTER_PORT=50051
GFS_CHUNK1_PORT=8080
GFS_CHUNK2_PORT=8081