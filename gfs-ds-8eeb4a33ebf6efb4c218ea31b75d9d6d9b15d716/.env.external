# External Machine Mode Config
# Use this for running client on HOST MACHINE or REMOTE DEVICE
# Replace 10.236.97.159 with YOUR server's IP address
# Commands:
#   cp .env.external .env
#   docker compose up -d --build
#   # Then on host/remote machine:
#   ./bin/gfs-client --config configs/external/client-config.yml

GFS_MODE=external
GFS_CHUNK1_HOST=10.236.97.159
GFS_CHUNK2_HOST=10.236.97.159
GFS_MASTER_HOST=10.236.97.159
GFS_MASTER_PORT=50051
GFS_CHUNK1_PORT=8080
GFS_CHUNK2_PORT=8081
